<Window x:Class="PhysicsSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhysicsSimulation"
        Title="Моделирование отскока шара"
        Width="1100" Height="760" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1C1C1C"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="NumericInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <local:SimulationSurface x:Name="canvas"
                                 Grid.Column="0"
                                 ClipToBounds="True"
                                 Focusable="True"
                                 MouseDown="Canvas_MouseDown"
                                 MouseMove="Canvas_MouseMove"
                                 MouseUp="Canvas_MouseUp" />

        <Border Grid.Column="1" Background="#252526" BorderBrush="#3A3A3D" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,15,16,18">
                    <Border Background="#2D2D30" Padding="12" CornerRadius="3" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="РЕЗУЛЬТАТЫ" FontSize="12" FontWeight="Bold" Foreground="#8CC8F0" Margin="0,0,0,8" />
                            <TextBlock x:Name="lblStats" Text="Результаты..." FontSize="13" LineHeight="23" TextWrapping="Wrap" Foreground="#E0E0E0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ПАРАМЕТРЫ СИМУЛЯЦИИ" FontSize="12" FontWeight="Bold" Foreground="#8CC8F0" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Радиус шара (м):" />
                        <TextBox x:Name="txtRadius" Grid.Row="0" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0,1" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Масса шара (кг):" />
                        <TextBox x:Name="txtMass" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0,1" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Нач. скорость (м/с):" />
                        <TextBox x:Name="txtV0" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Угол броска (град):" />
                        <TextBox x:Name="txtAngleLaunch" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Коэфф. упругости:" />
                        <TextBox x:Name="txtRestitution" Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0,8" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Коэфф. трения:" />
                        <TextBox x:Name="txtFriction" Grid.Row="5" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0,1" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Гравитация (м/с²):" />
                        <TextBox x:Name="txtGravity" Grid.Row="6" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="9,81" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource InputLabelStyle}" Text="Наклон поверхности (°):" />
                        <TextBox x:Name="txtAngleSurface" Grid.Row="7" Grid.Column="1" Style="{StaticResource NumericInputStyle}" Text="0" />
                    </Grid>

                    <Grid Margin="-3,0,-3,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnStart" Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Background="#007ACC" Content="СТАРТ" Click="BtnStart_Click" />
                        <Button x:Name="btnPause" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Background="#CA5100" Content="ПАУЗА" Click="BtnPause_Click" />
                        <Button x:Name="btnReset" Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Background="#BE1E2D" Content="СБРОС" Click="BtnReset_Click" />
                    </Grid>

                    <Button x:Name="btnExport" Style="{StaticResource ActionButtonStyle}" Background="#3E3E42" Content="💾 Экспорт отчета в TXT" Click="BtnExport_Click" Margin="0,3,0,5" />
                    <Button x:Name="btnScreenshot" Style="{StaticResource ActionButtonStyle}" Background="#3E3E42" Content="📸 Скриншот программы" Click="BtnScreenshot_Click" Margin="0,3,0,8" />
                    <CheckBox x:Name="chkShowTrajectory" IsChecked="True" Foreground="White" FontSize="13" Content="Показывать неоновый след траектории" Checked="ChkShowTrajectory_CheckedChanged" Unchecked="ChkShowTrajectory_CheckedChanged" Margin="0,6,0,8" />

                    <Border Background="#202022" Padding="10" CornerRadius="3" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="УПРАВЛЕНИЕ" FontSize="12" FontWeight="Bold" Foreground="#8CC8F0" Margin="0,0,0,5" />
                            <TextBlock Text="• Левый клик — разместить шар" TextWrapping="Wrap" Foreground="#BDBDBD" FontSize="12" />
                            <TextBlock Text="• Зажмите правую кнопку и потяните от шара — задать скорость и угол броска" TextWrapping="Wrap" Foreground="#BDBDBD" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
