<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рисование" Height="600" Width="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">

            <TextBlock Text="Фигура:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="kind"
                      Width="150"
                      SelectedIndex="0"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Линия"/>
                <ComboBoxItem Content="Круг"/>
                <ComboBoxItem Content="Квадрат"/>
            </ComboBox>

            <Button Content="Очистить холст"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    Click="Clear"/>

        </StackPanel>

        <Canvas x:Name="board"
                Grid.Row="1"
                Margin="10"
                Background="WhiteSmoke"
                ClipToBounds="True"
                MouseLeftButtonDown="Down"
                MouseMove="Move"
                MouseLeftButtonUp="Up"/>

    </Grid>
</Window>