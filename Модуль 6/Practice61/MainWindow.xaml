<Window x:Class="Practice61.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Practice61 - Учёт сотрудников"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Учёт сотрудников организации"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">

            <TextBlock Text="ФИО сотрудника"/>
            <TextBox x:Name="txtFullName" Margin="0,3,0,8"/>

            <TextBlock Text="Должность"/>
            <TextBox x:Name="txtPosition" Margin="0,3,0,8"/>

            <TextBlock Text="Отдел"/>
            <TextBox x:Name="txtDepartment" Margin="0,3,0,8"/>

            <TextBlock Text="Телефон"/>
            <TextBox x:Name="txtPhone" Margin="0,3,0,8"/>

            <TextBlock Text="Оклад"/>
            <TextBox x:Name="txtSalary" Margin="0,3,0,10"/>

            <StackPanel Orientation="Horizontal">

                <Button Content="Добавить"
                        Width="110"
                        Height="30"
                        Margin="0,0,10,0"
                        Click="AddButton_Click"/>

                <Button Content="Изменить"
                        Width="110"
                        Height="30"
                        Margin="0,0,10,0"
                        Click="UpdateButton_Click"/>

                <Button Content="Удалить"
                        Width="110"
                        Height="30"
                        Click="DeleteButton_Click"/>

            </StackPanel>

        </StackPanel>

        <DataGrid x:Name="EmployeesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="EmployeesGrid_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="45"/>

                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding FullName}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Должность"
                                    Binding="{Binding Position}"
                                    Width="*"/>

                <DataGridTextColumn Header="Отдел"
                                    Binding="{Binding Department}"
                                    Width="*"/>

                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding Phone}"
                                    Width="*"/>

                <DataGridTextColumn Header="Оклад"
                                    Binding="{Binding Salary}"
                                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>