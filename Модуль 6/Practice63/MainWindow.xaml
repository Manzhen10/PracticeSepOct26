<Window x:Class="Practice63.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Practice63 — Библиотека"
        Height="650" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Учет книг в библиотеке"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        <GroupBox Grid.Row="1" Header="Поиск книг" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch"
                         Height="32"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         TextChanged="txtSearch_TextChanged"/>

                <Button Grid.Column="1"
                        Content="Очистить"
                        Width="100"
                        Height="32"
                        Margin="10,0,0,0"
                        Click="ClearSearch_Click"/>
            </Grid>
        </GroupBox>

        <!-- Добавление книги -->
        <GroupBox Grid.Row="2" Header="Добавление новой книги"
                  Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Название"/>
                    <TextBox x:Name="txtTitle" Height="30" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Автор"/>
                    <TextBox x:Name="txtAuthor" Height="30" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Год издания"/>
                    <TextBox x:Name="txtYear" Height="30" Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Добавить книгу"
                        Width="125"
                        Height="35"
                        VerticalAlignment="Bottom"
                        Click="AddBook_Click"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3"
                  x:Name="BooksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Margin="0,0,0,12">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="50"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Title}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Автор"
                                    Binding="{Binding Author}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Год"
                                    Binding="{Binding Year}"
                                    Width="80"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button Content="Взять книгу"
                    Width="130"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="RentBook_Click"/>

            <Button Content="Вернуть книгу"
                    Width="130"
                    Height="38"
                    Click="ReturnBook_Click"/>
        </StackPanel>
    </Grid>
</Window>
