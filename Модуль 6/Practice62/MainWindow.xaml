<Window x:Class="Practice62.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Practice62 - Учёт задач"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Система учёта задач"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0"
                        Margin="0,0,10,10">
                <TextBlock Text="Название задачи"/>
                <TextBox x:Name="txtTitle" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1"
                        Margin="0,0,10,10">
                <TextBlock Text="Статус"/>
                <ComboBox x:Name="cmbStatus"
                          SelectedIndex="0"
                          Margin="0,3,0,0">
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2"
                        Margin="0,0,0,10">
                <TextBlock Text="Срок выполнения"/>
                <DatePicker x:Name="dpDueDate"
                            Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10">
                <TextBlock Text="Описание задачи"/>
                <TextBox x:Name="txtDescription"
                         Height="55"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal">

                <Button Content="Добавить"
                        Width="110" Height="30"
                        Margin="0,0,10,0"
                        Click="AddButton_Click"/>

                <Button Content="Изменить"
                        Width="110" Height="30"
                        Margin="0,0,10,0"
                        Click="UpdateButton_Click"/>

                <Button Content="Удалить"
                        Width="110" Height="30"
                        Margin="0,0,10,0"
                        Click="DeleteButton_Click"/>

                <Button Content="Очистить поля"
                        Width="120" Height="30"
                        Click="ClearButton_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="TasksGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="TasksGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="45"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Title}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Срок"
                                    Binding="{Binding DueDate}"
                                    Width="*"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="*"/>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Window>