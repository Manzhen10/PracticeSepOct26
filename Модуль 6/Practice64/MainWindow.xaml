<Window x:Class="Practice64.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Practice64 — Мои финансы"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Мои финансы"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Простой учет доходов и расходов"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Доходы за месяц"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="txtIncome"
                               Text="0,00 BYN"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#15803D"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Расходы за месяц"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="txtExpense"
                               Text="0,00 BYN"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Остаток за месяц"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="txtBalance"
                               Text="0,00 BYN"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="6"
                           Text="Добавление и редактирование"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Тип"/>
                    <ComboBox x:Name="cmbType"
                              SelectedIndex="1"
                              Height="32"
                              Margin="0,4,0,10">
                        <ComboBoxItem Content="Доход"/>
                        <ComboBoxItem Content="Расход"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Категория"/>
                    <TextBox x:Name="txtCategory"
                             Height="32"
                             Padding="6"
                             Margin="0,4,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Описание"/>
                    <TextBox x:Name="txtDescription"
                             Height="32"
                             Padding="6"
                             Margin="0,4,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Сумма, BYN"/>
                    <TextBox x:Name="txtAmount"
                             Height="32"
                             Padding="6"
                             Margin="0,4,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Дата"/>
                    <DatePicker x:Name="dpDate"
                                Height="32"
                                Margin="0,4,0,10"/>
                </StackPanel>

                <Button x:Name="btnSave"
                        Grid.Row="1"
                        Grid.Column="5"
                        Content="Добавить"
                        Width="105"
                        Height="32"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,10"
                        Click="Save_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"/>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="6"
                            Orientation="Horizontal">

                    <Button Content="Изменить выбранную"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="Edit_Click"/>

                    <Button Content="Отмена"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"/>

                    <Button Content="Удалить выбранную"
                            Padding="12,6"
                            Click="Delete_Click"
                            Background="#FEE2E2"
                            Foreground="#B91C1C"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch"
                     Grid.Column="0"
                     Height="34"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     ToolTip="Поиск по категории и описанию"
                     TextChanged="Search_TextChanged"
                     Margin="0,0,10,0"/>

            <ComboBox x:Name="cmbFilter"
                      Grid.Column="1"
                      Height="34"
                      SelectedIndex="0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все операции"/>
                <ComboBoxItem Content="Доходы"/>
                <ComboBoxItem Content="Расходы"/>
                <ComboBoxItem Content="Только этот месяц"/>
            </ComboBox>
        </Grid>

        <DataGrid Grid.Row="4"
                  x:Name="TransactionsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  AlternationCount="2"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding Type}"
                                    Width="90"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="*"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding AmountText}"
                                    Width="125"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5"
                   x:Name="txtStatus"
                   Text="Приложение готово к работе"
                   Foreground="#64748B"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
