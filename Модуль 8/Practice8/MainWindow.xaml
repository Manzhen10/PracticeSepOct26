<Window x:Class="Practice8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Practice8"
        Title="Practice8"
        Height="800"
        Width="1220"
        MinHeight="700"
        MinWidth="1050"
        Background="#F1F5F9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <local:HasEntriesConverter x:Key="HasEntriesConverter"/>
        <Style x:Key="MarkedCalendarDayStyle"
               TargetType="{x:Type CalendarDayButton}">

            <Style.Triggers>

                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding
                            Converter="{StaticResource HasEntriesConverter}">

                            <Binding Path="DataContext"
                                     RelativeSource="{RelativeSource Self}"/>

                            <Binding Path="DaysWithEntries"
                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>

                        </MultiBinding>
                    </DataTrigger.Binding>

                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="FontWeight" Value="Bold"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#1D4ED8"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Планировка задачек"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Планировщик задач и событий"
                               FontSize="14"
                               Foreground="#DBEAFE"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock x:Name="StatsTextBlock"
                           Grid.Column="1"
                           Text="Записей: 0 | Выполнено: 0"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="12,0,0,0"/>

            </Grid>

        </Border>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14">

                <StackPanel>

                    <TextBlock Text="Календарь"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#172554"/>

                    <TextBlock Text="Выберите день для просмотра записей"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,4,0,8"/>

                    <Calendar x:Name="PlannerCalendar"
                              CalendarDayButtonStyle="{StaticResource MarkedCalendarDayStyle}"
                              SelectedDatesChanged="PlannerCalendar_SelectedDatesChanged"
                              Margin="0,4,0,10"/>

                    <Button Content="Перейти на сегодня"
                            Height="36"
                            Click="TodayButton_Click"/>

                    <CheckBox x:Name="ShowAllCheckBox"
                              Content="Показывать все записи"
                              Margin="4,12,0,12"
                              IsChecked="False"
                              Checked="FilterSettings_Changed"
                              Unchecked="FilterSettings_Changed"/>

                    <TextBlock x:Name="SelectedDateTextBlock"
                               Text="Выбранная дата:"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="3,0,0,10"/>

                    <Separator Background="#E2E8F0"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Обозначения"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="3,0,0,8"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="3,2">
                        <Border Width="14"
                                Height="14"
                                Background="#DBEAFE"
                                BorderBrush="#93C5FD"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,0,8,0"/>

                        <TextBlock Text="На этот день есть записи"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="3,5">
                        <Border Width="14"
                                Height="14"
                                Background="#2563EB"
                                CornerRadius="3"
                                Margin="0,0,8,0"/>

                        <TextBlock Text="Выбранная дата"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Напоминания работают, ТОЛЬКО пока приложение открыто."
                               TextWrapping="Wrap"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="3,14,3,0"/>

                </StackPanel>

            </Border>

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <GroupBox Grid.Row="0"
                          Header="Создание и редактирование записи"
                          Padding="10">

                    <Grid Margin="4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                     
                        <Grid Grid.Row="0"
                              Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Название:"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="TitleTextBox"
                                     Grid.Column="1"
                                     Height="32"
                                     Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="Тип:"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="TypeComboBox"
                                      Grid.Column="3"
                                      Height="32"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="Задача"/>
                                <ComboBoxItem Content="Событие"/>

                            </ComboBox>

                        </Grid>

                  
                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,8">

                            <TextBlock Text="Описание"
                                       Margin="0,0,0,4"
                                       Foreground="#334155"/>

                            <TextBox x:Name="DescriptionTextBox"
                                     Height="52"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>

                        </StackPanel>

            
                        <Grid Grid.Row="2"
                              Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Дата:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <TextBlock x:Name="SelectedDateTextBlock2"
                                       Grid.Column="1"
                                       Text="Выберите дату"
                                       VerticalAlignment="Center"
                                       Foreground="#1D4ED8"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="2"
                                       Text="Время:"
                                       VerticalAlignment="Center"
                                       Margin="8,0,8,0"/>

                            <TextBox x:Name="TimeTextBox"
                                     Grid.Column="3"
                                     Text="09:00"
                                     Height="32"/>

                        </Grid>

                        <WrapPanel Grid.Row="3"
                                   Margin="0,0,0,8"
                                   VerticalAlignment="Center">

                            <CheckBox x:Name="HasReminderCheckBox"
                                      Content="Напомнить за"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="3,0,8,0"/>

                            <ComboBox x:Name="ReminderMinutesComboBox"
                                      Width="68"
                                      Height="28"
                                      SelectedIndex="1">

                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>

                            </ComboBox>

                            <TextBlock Text="минут до срока"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="#475569"/>

                        </WrapPanel>

      
                        <WrapPanel Grid.Row="4">

                            <Button x:Name="AddOrUpdateButton"
                                    Content="+ Добавить запись"
                                    MinWidth="145"
                                    Height="36"
                                    Click="AddOrUpdateButton_Click"/>

                            <Button Content="Изменить"
                                    MinWidth="90"
                                    Height="36"
                                    Background="#0F766E"
                                    Click="EditSelectedButton_Click"/>

                            <Button Content="Изменить статус"
                                    MinWidth="120"
                                    Height="36"
                                    Background="#7C3AED"
                                    Click="MarkCompletedButton_Click"/>

                            <Button Content="Удалить"
                                    MinWidth="80"
                                    Height="36"
                                    Background="#DC2626"
                                    Click="DeleteSelectedButton_Click"/>

                            <Button Content="Очистить поля"
                                    MinWidth="105"
                                    Height="36"
                                    Background="#64748B"
                                    Click="ClearFormButton_Click"/>

                            <Button x:Name="CancelEditButton"
                                    Content="Отменить изменение"
                                    MinWidth="145"
                                    Height="36"
                                    Background="#64748B"
                                    Visibility="Collapsed"
                                    Click="CancelEditButton_Click"/>

                        </WrapPanel>

                    </Grid>

                </GroupBox>

       
                <GroupBox Grid.Row="2"
                          Header="Список задач и событий"
                          Padding="6">

                    <DataGrid x:Name="ItemsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AlternationCount="2"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              Background="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column"
                              MouseDoubleClick="ItemsGrid_MouseDoubleClick">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,7"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                 Value="True">

                                        <Setter Property="Opacity"
                                                Value="0.55"/>

                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding Title}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Тип"
                                                Binding="{Binding Category}"
                                                Width="85"/>

                            <DataGridTextColumn Header="Срок выполнения"
                                                Binding="{Binding Deadline,
                                                StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                Width="145"/>

                            <DataGridCheckBoxColumn Header="Выполнено"
                                                    Binding="{Binding IsCompleted}"
                                                    Width="85"/>

                            <DataGridCheckBoxColumn Header="Напоминание"
                                                    Binding="{Binding HasReminder}"
                                                    Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

            </Grid>

        </Grid>

    </Grid>

</Window>